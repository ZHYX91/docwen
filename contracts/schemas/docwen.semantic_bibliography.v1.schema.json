{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:docwen:schema:semantic-bibliography:v1",
  "title": "DocWen Presented Bibliography v1",
  "type": "object",
  "required": ["schema", "entries"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "docwen.semantic_bibliography.v1"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item_id", "runs"],
        "additionalProperties": false,
        "properties": {
          "item_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._-]*$",
            "maxLength": 20
          },
          "runs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["text"],
              "additionalProperties": false,
              "properties": {
                "text": {"type": "string", "minLength": 1},
                "bold": {"type": "boolean"},
                "italic": {"type": "boolean"},
                "href": {
                  "type": "string",
                  "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://[^/?#\\s]+(?:[/?#].*)?$"
                }
              }
            }
          }
        }
      }
    }
  }
}
