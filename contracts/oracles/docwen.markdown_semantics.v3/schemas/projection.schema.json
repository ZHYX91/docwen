{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:docwen:schema:markdown-semantics:v3",
  "title": "DocWen Markdown Semantics v3 Source Projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema", "source", "targets", "anchors", "fenced_sources", "links", "references", "citations"],
  "properties": {
    "$schema": {"const": "urn:docwen:schema:markdown-semantics:v3"},
    "schema": {"const": "docwen.markdown_semantics.v3"},
    "source": {"$ref": "#/$defs/source"},
    "targets": {"type": "array", "items": {"$ref": "#/$defs/target"}},
    "anchors": {"type": "array", "items": {"$ref": "#/$defs/anchor"}},
    "fenced_sources": {"type": "array", "items": {"$ref": "#/$defs/fencedSource"}},
    "links": {"type": "array", "items": {"$ref": "#/$defs/link"}},
    "references": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
    "citations": {"type": "array", "items": {"$ref": "#/$defs/citation"}}
  },
  "$defs": {
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 0}
      }
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_id", "sha256", "encoding", "coordinate_system", "offset_base", "range_end"],
      "properties": {
        "input_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "sha256": {"$ref": "#/$defs/sha256"},
        "encoding": {"const": "utf-8"},
        "coordinate_system": {"const": "unicode_code_point"},
        "offset_base": {"const": 0},
        "range_end": {"const": "exclusive"}
      }
    },
    "id": {"type": "string", "pattern": "^[A-Za-z0-9-]{1,128}$"},
    "targetKind": {"enum": ["heading", "figure", "table", "equation", "code_block"]},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "title", "number", "source_form", "range"],
      "properties": {
        "kind": {"$ref": "#/$defs/targetKind"},
        "id": {"$ref": "#/$defs/id"},
        "id_range": {"$ref": "#/$defs/range"},
        "title": {"type": "string"},
        "number": {"type": "string", "minLength": 1},
        "source_form": {"enum": ["heading", "declaration"]},
        "range": {"$ref": "#/$defs/range"},
        "heading_level": {"type": "integer", "minimum": 1, "maximum": 9},
        "heading_path": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {"type": "string", "minLength": 1}
        },
        "source_keyword": {"type": "string", "minLength": 1},
        "declaration_range": {"$ref": "#/$defs/range"},
        "object_range": {"$ref": "#/$defs/range"}
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "block_kind", "placement", "range", "block_range", "container_path"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "block_kind": {
          "enum": ["paragraph", "image", "table", "equation", "code_block", "list", "list_item", "block_quote", "callout", "fenced_block"]
        },
        "placement": {"enum": ["inline", "post_block"]},
        "range": {"$ref": "#/$defs/range"},
        "block_range": {"$ref": "#/$defs/range"},
        "container_path": {
          "type": "array",
          "items": {"$ref": "#/$defs/containerPathSegment"}
        }
      }
    },
    "containerPathSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["block_kind", "block_range"],
      "properties": {
        "block_kind": {"enum": ["list", "list_item", "block_quote", "callout"]},
        "block_range": {"$ref": "#/$defs/range"}
      }
    },
    "base64": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "eol": {"enum": ["", "\n", "\r\n"]},
    "fencedSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "source_sha256",
        "source_start",
        "source_end",
        "identity_sha256",
        "block_sha256",
        "body_sha256",
        "fence_character",
        "opening_length",
        "opening_prefix_b64",
        "info_b64",
        "opening_eol",
        "body_prefix_count",
        "body_prefixes_b64",
        "closing_state",
        "closing_length",
        "closing_prefix_b64",
        "closing_suffix_b64",
        "closing_eol"
      ],
      "properties": {
        "tag": {"type": "string", "pattern": "^docwen-fenced-source-v1:[0-9a-f]{32}$"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "source_start": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "source_end": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "identity_sha256": {"$ref": "#/$defs/sha256"},
        "block_sha256": {"$ref": "#/$defs/sha256"},
        "body_sha256": {"$ref": "#/$defs/sha256"},
        "fence_character": {"enum": ["`", "~"]},
        "opening_length": {"type": "integer", "minimum": 3, "maximum": 65536},
        "opening_prefix_b64": {"allOf": [{"$ref": "#/$defs/base64"}, {"maxLength": 21848}]},
        "info_b64": {"allOf": [{"$ref": "#/$defs/base64"}, {"maxLength": 21848}]},
        "opening_eol": {"$ref": "#/$defs/eol"},
        "body_prefix_count": {"type": "integer", "minimum": 0, "maximum": 65536},
        "body_prefixes_b64": {"allOf": [{"$ref": "#/$defs/base64"}, {"maxLength": 1398104}]},
        "closing_state": {"enum": ["present", "omitted_eof"]},
        "closing_length": {"type": "integer", "minimum": 0, "maximum": 65536},
        "closing_prefix_b64": {"allOf": [{"$ref": "#/$defs/base64"}, {"maxLength": 21848}]},
        "closing_suffix_b64": {"allOf": [{"$ref": "#/$defs/base64"}, {"maxLength": 21848}]},
        "closing_eol": {"$ref": "#/$defs/eol"}
      },
      "allOf": [
        {
          "if": {"properties": {"closing_state": {"const": "omitted_eof"}}},
          "then": {
            "properties": {
              "closing_length": {"const": 0},
              "closing_prefix_b64": {"const": ""},
              "closing_suffix_b64": {"const": ""},
              "closing_eol": {"const": ""}
            }
          },
          "else": {
            "properties": {
              "closing_length": {"minimum": 3},
              "opening_eol": {"enum": ["\n", "\r\n"]},
              "closing_eol": {"enum": ["", "\n", "\r\n"]}
            }
          }
        }
      ]
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "raw", "range", "page_locator"],
      "properties": {
        "kind": {"enum": ["link", "embed"]},
        "raw": {"type": "string", "minLength": 4},
        "range": {"$ref": "#/$defs/range"},
        "page_locator": {"type": "string"},
        "fragment_kind": {"enum": ["stable_id", "heading_path"]},
        "target_id": {"type": "string"},
        "heading_path": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "alias": {"type": "string"}
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector_kind", "raw", "range", "resolution_status"],
      "properties": {
        "selector_kind": {"enum": ["stable_id", "heading_path"]},
        "target_id": {"type": "string"},
        "heading_path": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "page_locator": {"type": "string", "minLength": 1},
        "alias": {"type": "string", "minLength": 1},
        "alias_range": {"$ref": "#/$defs/range"},
        "raw": {"type": "string", "minLength": 6},
        "range": {"$ref": "#/$defs/range"},
        "resolution_status": {"enum": ["resolved", "missing", "ambiguous", "non_semantic", "unnumbered", "external_unresolved"]},
        "resolved_document_id": {"type": "string", "minLength": 1},
        "resolved_document_sha256": {"$ref": "#/$defs/sha256"},
        "resolved_kind": {"$ref": "#/$defs/targetKind"},
        "resolved_target_id": {"$ref": "#/$defs/id"},
        "cached_number": {"type": "string", "minLength": 1}
      },
      "oneOf": [
        {"required": ["target_id"], "properties": {"selector_kind": {"const": "stable_id"}}},
        {"required": ["heading_path"], "properties": {"selector_kind": {"const": "heading_path"}}}
      ]
    },
    "citationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "key_range", "resolution_status"],
      "properties": {
        "key": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
        "key_range": {"$ref": "#/$defs/range"},
        "resolution_status": {"enum": ["unresolved", "resolved"]},
        "resolved_record_id": {"type": "string", "minLength": 1},
        "resolved_record_sha256": {"$ref": "#/$defs/sha256"},
        "presentation": {"type": "string", "minLength": 1}
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["form", "raw", "range", "items"],
      "properties": {
        "form": {"enum": ["narrative", "parenthetical"]},
        "raw": {"type": "string", "minLength": 2},
        "range": {"$ref": "#/$defs/range"},
        "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/citationItem"}}
      }
    }
  }
}
