{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:docwen:schema:markdown-diagnostics:v3",
  "title": "DocWen Markdown Diagnostics v3 Oracle",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema", "source", "diagnostics"],
  "properties": {
    "$schema": {"const": "urn:docwen:schema:markdown-diagnostics:v3"},
    "schema": {"const": "docwen.markdown_diagnostics.v3"},
    "source": {"$ref": "urn:docwen:schema:markdown-semantics:v3#/$defs/source"},
    "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}}
  },
  "$defs": {
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 0}
      }
    },
    "edit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["range", "replacement"],
      "properties": {
        "range": {"$ref": "#/$defs/range"},
        "replacement": {"type": "string", "maxLength": 4096}
      }
    },
    "fix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fix_id", "edits"],
      "properties": {
        "fix_id": {
          "enum": [
            "docwen.markdown.fix.rename_anchor",
            "docwen.markdown.fix.add_semantic_id",
            "docwen.markdown.fix.move_anchor_to_declaration"
          ]
        },
        "edits": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/edit"}}
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "code", "message", "evidence_schema", "source", "range"],
      "properties": {
        "severity": {"enum": ["warning", "error"]},
        "code": {
          "enum": [
            "docwen.markdown.anchor.dangling",
            "docwen.markdown.anchor.duplicate",
            "docwen.markdown.anchor.invalid_id",
            "docwen.markdown.caption.content_required",
            "docwen.markdown.caption.object_mismatch",
            "docwen.markdown.caption.empty_equation_target_required",
            "docwen.markdown.cross_reference.missing",
            "docwen.markdown.cross_reference.ambiguous",
            "docwen.markdown.cross_reference.non_semantic_target",
            "docwen.markdown.cross_reference.unnumbered_target",
            "docwen.markdown.cross_reference.alias_stale"
          ]
        },
        "message": {"type": "string", "minLength": 1, "maxLength": 4096},
        "evidence_schema": {"const": "docwen.machine.diagnostic_evidence.v1"},
        "source": {"$ref": "urn:docwen:schema:markdown-semantics:v3#/$defs/source"},
        "range": {"$ref": "#/$defs/range"},
        "related_ranges": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/range"}},
        "fixes": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/fix"}}
      }
    }
  }
}
