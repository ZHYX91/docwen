          },
          {
            "severity": "warning",
            "code": "physical_page_ocr.consumer_owned_import",
            "message": "The Bundle reports page and resource facts only; Node layout, basenames, and import strategy remain consumer-owned."
          },
          {
            "severity": "warning",
