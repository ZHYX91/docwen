          "relation_payloads": [
            "page_fragment",
            "page_resource"
          ]
        },
        "options_schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "preserve_resources": {
              "type": "boolean",
              "default": true
            },
            "recognize_text": {
              "type": "boolean",
              "default": false
            },
            "ocr_language": {
              "type": "string",
