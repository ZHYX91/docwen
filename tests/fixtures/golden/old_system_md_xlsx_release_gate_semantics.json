      "expected_merged_ranges": [],
      "expected_metadata": {
        "markdown_table_merges": 0,
        "markdown_table_merge_warnings": 1
      }
    },
    "template_merge_conflict_keeps_template_merge": {
      "input_markdown": "| A | B |\n| --- | --- |\n| merged | < |\n",
      "expected_cells": {
        "A1": "merged",
        "B1": "<"
      },
      "expected_merged_ranges": [
        "A1:A2"
      ],
      "expected_metadata": {
        "markdown_table_merges": 0,
        "markdown_table_merge_warnings": 1
      }
