      "embedded_markdown": "第一行\n第二行 | 三",
      "input_markdown": "| Name | Age |\n| --- | --- |\n| ![[embed.md]] | <https://example.com> |\n| <user@example.com> | 20 |\n",
      "expected_cells": {
        "A1": "第一行\n第二行 | 三",
        "B1": "https://example.com",
        "A2": "user@example.com",
        "B2": "20"
      }
