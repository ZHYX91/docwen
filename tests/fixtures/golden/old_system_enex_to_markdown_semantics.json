  "accepted_differences": [
    {
      "difference": "Old systems preserve YAML frontmatter and leak the ENML XML declaration into Markdown body; current runtime now preserves YAML frontmatter, keeps a Markdown note heading for the single-artifact runtime contract, and strips the ENML XML/DOCTYPE/en-note envelope before markdownify.",
      "classification": "current_architecture_improvement",
      "reason": "The old leak is parser noise, not user-authored note content. Current output preserves the note title and body semantics while avoiding XMLParsedAsHTMLWarning-style body noise."
    },
    {
      "difference": "Old systems write one Markdown file per note directly to the output folder; current runtime returns one primary ArtifactManifest for this single-note smoke.",
      "classification": "current_runtime_output_contract",
      "reason": "Runtime staging/finalizer owns artifact materialization in the rewrite. The single-note semantic content and metadata are preserved."
    },
    {
      "difference": "Old Tk/PySide6 ENEX image resources can become nested Markdown image syntax after markdownify converts the generated img tag and the converter then replaces the token with another image link; current rewrite strips the ENML envelope and replaces resource tokens with one readable link per finalized image.",
      "classification": "accepted_current_architecture_improvement",
      "reason": "The user-visible goal is readable Markdown with extracted resources finalized beside it. Recreating old nested image syntax and XML declaration noise would be a UI/UX regression."
    }
  ],
