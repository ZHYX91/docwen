{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:docwen:schema:linux-production-manifest:v1",
  "title": "DocWen Linux production manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "manifestId",
    "product",
    "target",
    "archive",
    "symlinks",
    "generatedMetadata",
    "artifacts"
  ],
  "properties": {
    "$schema": {
      "const": "./linux-production-manifest.v1.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "manifestId": {
      "const": "docwen-linux-production"
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "DocWen"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "distribution",
        "version",
        "arch",
        "platformTag"
      ],
      "properties": {
        "os": {
          "const": "linux"
        },
        "distribution": {
          "const": "ubuntu"
        },
        "version": {
          "const": "24.04"
        },
        "arch": {
          "const": "x86_64"
        },
        "platformTag": {
          "const": "linux-x64"
        }
      }
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "tarFormat",
        "entryOrder",
        "reproducibilityEpoch",
        "uid",
        "gid",
        "uname",
        "gname",
        "directoryMode",
        "entryPointMode",
        "executableFileMode",
        "regularFileMode",
        "symlinkMode",
        "compressionLevel",
        "gzipHeaderFilename",
        "gzipHeaderExtraFlags",
        "gzipHeaderOperatingSystem"
      ],
      "properties": {
        "format": {
          "const": "tar.gz"
        },
        "tarFormat": {
          "const": "pax"
        },
        "entryOrder": {
          "const": "utf8-byte-lexicographic"
        },
        "reproducibilityEpoch": {
          "type": "integer",
          "minimum": 315532800,
          "maximum": 4294967295
        },
        "uid": {
          "const": 0
        },
        "gid": {
          "const": 0
        },
        "uname": {
          "const": ""
        },
        "gname": {
          "const": ""
        },
        "directoryMode": {
          "const": "0755"
        },
        "entryPointMode": {
          "const": "0755"
        },
        "executableFileMode": {
          "const": "0755"
        },
        "regularFileMode": {
          "const": "0644"
        },
        "symlinkMode": {
          "const": "0777"
        },
        "compressionLevel": {
          "const": 9
        },
        "gzipHeaderFilename": {
          "const": ""
        },
        "gzipHeaderExtraFlags": {
          "const": 2
        },
        "gzipHeaderOperatingSystem": {
          "const": 255
        }
      }
    },
    "symlinks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "preserve",
        "rejectAbsolute",
        "rejectEscape",
        "rejectDangling",
        "rejectCycles",
        "rejectDirectoryTargets"
      ],
      "properties": {
        "policy": {
          "const": "relative-internal-files-only"
        },
        "preserve": {
          "const": true
        },
        "rejectAbsolute": {
          "const": true
        },
        "rejectEscape": {
          "const": true
        },
        "rejectDangling": {
          "const": true
        },
        "rejectCycles": {
          "const": true
        },
        "rejectDirectoryTargets": {
          "const": true
        }
      }
    },
    "generatedMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payloadManifestPath",
        "payloadManifestSchema",
        "checksumsPath",
        "checksumsCoverage"
      ],
      "properties": {
        "payloadManifestPath": {
          "const": "manifest.json"
        },
        "payloadManifestSchema": {
          "const": "docwen.linux.payload.v1"
        },
        "checksumsPath": {
          "const": "SHA256SUMS.txt"
        },
        "checksumsCoverage": {
          "const": "all-regular-files-except-self"
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "$defs": {
    "safeRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\\\\\r\\n\\u0000]+$"
    },
    "safeTopLevelName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[^/\\\\\\r\\n\\u0000]+$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "payloadLayout",
        "sourceDirectory",
        "archiveName",
        "topLevelDirectory",
        "entryPoints",
        "requiredFiles",
        "requiredDirectories",
        "allowedTopLevelFiles",
        "allowedTopLevelDirectories"
      ],
      "properties": {
        "artifactId": {
          "enum": [
            "gui-cli",
            "cli-only"
          ]
        },
        "payloadLayout": {
          "enum": [
            "unified-gui-cli-onedir",
            "cli-only-onedir"
          ]
        },
        "sourceDirectory": {
          "$ref": "#/$defs/safeTopLevelName"
        },
        "archiveName": {
          "type": "string",
          "pattern": "^[^/\\\\\\r\\n\\u0000]+\\.tar\\.gz$"
        },
        "topLevelDirectory": {
          "$ref": "#/$defs/safeTopLevelName"
        },
        "entryPoints": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/safeRelativePath"
          }
        },
        "requiredFiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/safeRelativePath"
          }
        },
        "requiredDirectories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/safeRelativePath"
          }
        },
        "allowedTopLevelFiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/safeTopLevelName"
          }
        },
        "allowedTopLevelDirectories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/safeTopLevelName"
          }
        }
      }
    }
  }
}
